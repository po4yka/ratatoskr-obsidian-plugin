# Resolve every package from the public npm registry, so a plain `npm ci` works on any machine.
registry=https://registry.npmjs.org/
# Every version in package.json is exact, and a new dependency is added exact too.
save-exact=true
# openapi-typescript@7.13.0 declares its TypeScript peer as `^5.x`, and this tree pins 6.0.3. Remove
# this line when upstream widens the range. The obsidian peers are listed in package.json by hand.
legacy-peer-deps=true
